EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Web uses window.location.origin + /auth/callback automatically.
# Never point this at aics-projects.vercel.app — Google and recovery must land
# on the real blOb host (production Vercel or localhost).
# Set this for native TestFlight so reset emails open a production https callback.
# Do not use this for Google Sign-In — native OAuth always returns to blob://oauthredirect.
# Also add that URL, blob://oauthredirect, and localhost /auth/callback in
# Supabase → Authentication → URL Configuration.
# EXPO_PUBLIC_AUTH_REDIRECT_URL=https://your-production-host/auth/callback
EXPO_PUBLIC_PAYMENTS_PROVIDER=stripe
PAYMENTS_PROVIDER=stripe
# Stripe secrets live on Supabase Edge Functions (create-top-up, stripe-webhook):
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
EXPO_PUBLIC_TENOR_KEY=
# Optional fallback if Tenor is unset:
# EXPO_PUBLIC_GIPHY_KEY=

