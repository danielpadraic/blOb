EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Web sign-up / reset emails use window.location.origin + /auth/callback.
# Native emails use EXPO_PUBLIC_AUTH_REDIRECT_URL only if it is https://…/auth/callback
# (Expo web host, including *.vercel.app). Never blob:// in emailRedirectTo — mail
# clients cannot open it. Never vercel.com (dashboard login). Do not set Site URL to blob://.
# After HTTPS confirm, the web callback offers blob://auth/callback to open the app.
# Google’s provider redirect_uri must stay https://<project>.supabase.co/auth/v1/callback.
# Also add production /auth/callback, blob://oauthredirect, and blob://auth/callback in
# Supabase → Authentication → URL Configuration.
# EXPO_PUBLIC_AUTH_REDIRECT_URL=https://your-production-host/auth/callback
#
# Vercel (Expo web, not the Next web/ harness): set these as plaintext Project
# Environment Variables for Production and Preview. They are inlined at
# `npx expo export --platform web` time. Same values as EAS.
# Required: EXPO_PUBLIC_SUPABASE_URL, EXPO_PUBLIC_SUPABASE_ANON_KEY
# Optional: EXPO_PUBLIC_PAYMENTS_PROVIDER, EXPO_PUBLIC_TENOR_KEY, EXPO_PUBLIC_GIPHY_KEY
# Do not set a blob:// EXPO_PUBLIC_AUTH_REDIRECT_URL on Vercel.
EXPO_PUBLIC_PAYMENTS_PROVIDER=stripe
PAYMENTS_PROVIDER=stripe
# Stripe secrets live on Supabase Edge Functions (create-top-up, stripe-webhook):
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# Native Google Sign-In (iOS + Android). Web still uses HTTPS /auth/callback OAuth.
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID = the Web client already in Supabase → Google provider
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID = iOS OAuth client (bundle com.blob.tournament)
# iosUrlScheme: com.googleusercontent.apps.49251028054-54pin15flhs2uhhtqhnjkblmdte62bka
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=49251028054-54pin15flhs2uhhtqhnjkblmdte62bka.apps.googleusercontent.com
# Add iOS (and Android) client IDs under Supabase Google “Authorized Client IDs” if present.
# Public google-signin cannot attach a custom nonce; enable Skip Nonce Check for native
# Google if ID-token sign-in fails with a nonce mismatch. Do not use blob:// on Web.
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_TENOR_KEY=
# Optional fallback if Tenor is unset:
# EXPO_PUBLIC_GIPHY_KEY=

